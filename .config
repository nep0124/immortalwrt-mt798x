# 基础硬件适配（MT7981芯片+MT7531AE交换机）

CONFIG_TARGET_BOARD="mediatek"

CONFIG_TARGET_SUBTARGET="mt7981"

CONFIG_TARGET_PROFILE="DEVICE_xiaomi_ax3000t"

CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"

CONFIG_CPU_TYPE="cortex-a53"



# 内核核心配置

CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_BUILD_USER="hanwcfk"

CONFIG_KERNEL_BUILD_DOMAIN="openwrt"



# 交换机驱动（非AN8855版必选）

CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-mii=y

CONFIG_PACKAGE_kmod-mt7530=y
CONFIG_PACKAGE_swconfig=y

CONFIG_PACKAGE_kmod-switch=y



# Wi-Fi驱动（MT7921芯片适配）

CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_kmod-mt7921-common=y

CONFIG_PACKAGE_mt7921-firmware=y

CONFIG_PACKAGE_wireless-tools=y



# 单代理工具，减少体积



# 基础网络功能

CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_dnsmasq-full_include_dnssec=y

CONFIG_PACKAGE_ip6tables=y

CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_iptables-mod-tproxy=y

CONFIG_PACKAGE_iptables-mod-extra=y



# 实用工具（精简核心）

CONFIG_PACKAGE_zram-swap=y  # 内存优化

CONFIG_PACKAGE_kmod-usb3=y  # USB3.0支持

CONFIG_PACKAGE_samba4-server=y

CONFIG_PACKAGE_luci-app-samba4=y  # 网络共享

CONFIG_PACKAGE_ddns-go=y

CONFIG_PACKAGE_luci-app-ddns-go=y  # DDNS



# 界面主题（仅保留Argon）

CONFIG_PACKAGE_luci-theme-argon=y

CONFIG_PACKAGE_luci-app-argon-config=y

# 关闭所有非必要功能（精简体积关键）

CONFIG_PACKAGE_nmap=n

CONFIG_PACKAGE_tcpdump=n

CONFIG_PACKAGE_htop=n

CONFIG_PACKAGE_sing-box=n

CONFIG_PACKAGE_hysteria2=n

CONFIG_PACKAGE_naiveproxy=n

CONFIG_PACKAGE_ssr-plus=n

CONFIG_PACKAGE_luci-theme-bootstrap=n

CONFIG_PACKAGE_kmod-switch-an8855=n


CONFIG_PACKAGE_luci-app-an8855-config=n

